<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1F24"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/llm_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Idle"
            android:textColor="#9AA5B1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/llm_clear"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="Clear"
            android:textColor="#9AA5B1" />

        <Button
            android:id="@+id/llm_settings_toggle"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="Settings"
            android:textColor="#9AA5B1" />
    </LinearLayout>

    <!-- Settings page: replaces the chat while open, and scrolls -->
    <ScrollView
        android:id="@+id/llm_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#252B33"
        android:orientation="vertical"
        android:padding="8dp">
        <!-- Bundled model server -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#252B33"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">
                <TextView
                    android:id="@+id/llm_model_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Model: stopped"
                    android:textColor="#C9D1D9"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/llm_model_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start model" />
            </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server URL (OpenAI-compatible)"
            android:textColor="#9AA5B1"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/llm_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/llm_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Test" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Model"
            android:textColor="#9AA5B1"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/llm_model_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="(first .gguf in /sdcard/atak/llm)"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/llm_model_choose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change" />

            <Button
                android:id="@+id/llm_model_get"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get more" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Run model on"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/llm_accel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:text="CPU" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/llm_maps_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Offline maps"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/llm_maps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map packs" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/llm_autostart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start the model automatically"
            android:textColor="#FFFFFF" />

        <CheckBox
            android:id="@+id/llm_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ask before the model edits the map"
            android:textColor="#FFFFFF" />

        <CheckBox
            android:id="@+id/llm_thinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable model reasoning (slower)"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/credits"
            android:textColor="#6B7785"
            android:textSize="11sp" />
    </LinearLayout>
    </ScrollView>

    <!-- Transcript -->
    <ScrollView
        android:id="@+id/llm_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/llm_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Input -->
    <LinearLayout
        android:id="@+id/llm_input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/llm_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ask about the map…"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="4"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7785" />

        <Button
            android:id="@+id/llm_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send" />
    </LinearLayout>
</LinearLayout>
